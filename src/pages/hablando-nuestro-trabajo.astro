---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Tabs from '../components/Tabs.astro';
import TabPanel from '../components/TabPanel.astro';
import DeviceMockup from '../components/DeviceMockup.astro';
import FeatureBand from '../components/FeatureBand.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import IntroPoints from '../components/IntroPoints.astro';
import { perfil, revisaTuPitch, pasosDemo } from '../data/cv';

// The deck is a static file of this site (public/hablando/presentacion.html); the rest
// of /hablando redirects here.
const urlPresentacion = '/hablando/presentacion.html?theme=light';

/** The three blocks under the title. Icons are inline SVG paths on a 32 × 32 grid. */
const puntos = [
	{
		titulo: '¿Qué es?',
		texto:
			'Una charla para aprender a comunicar lo que hacemos. Nos enseña a entender cómo funciona la comunicación, a contar nuestras ideas como una historia y, de esta forma, exponer con claridad.',
		// speech bubble
		icono:
			'<path d="M5 8a3 3 0 0 1 3-3h16a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H14l-6 5v-5H8a3 3 0 0 1-3-3Z"/><path d="M10 11.5h12M10 16h8"/>',
	},
	{
		titulo: '¿Para quién?',
		texto:
			'Para quienes presentan ante equipos, líderes o clientes y buscan sentirse más seguros al mostrar una idea propia. Principalmente para personas del rubro del diseño y la tecnología.',
		// a person in front of an audience
		icono:
			'<circle cx="16" cy="8" r="3.5"/><path d="M10 19a6 6 0 0 1 12 0"/><circle cx="6.5" cy="21" r="2.5"/><circle cx="25.5" cy="21" r="2.5"/><path d="M2.5 29a4 4 0 0 1 8 0M21.5 29a4 4 0 0 1 8 0"/>',
	},
	{
		titulo: '¿En qué consiste?',
		texto:
			'Una breve exposición sobre cómo exponer en público junto con 2 actividades. Incluye la presentación, un artefacto especializado para revisión de pitch y respuesta de preguntas.',
		// screen with a play mark, on a stand
		icono:
			'<rect x="4" y="5" width="24" height="16" rx="2"/><path d="m14 10 5 3-5 3Z"/><path d="M16 21v6M11 27h10"/>',
	},
];
---

<BaseLayout
	title={`Hablando nuestro trabajo · ${perfil.nombreCorto}`}
	description="«Hablando nuestro trabajo», la charla de Catalina Callejas para comunicar mejor lo que hacemos en equipos de producto y tecnología."
	current="hablando"
>
	<PageIntro crumb="Hablando" title="Hablando nuestro trabajo" divider={false}>
		<IntroPoints slot="lead" tag="Más que una charla" tagUnderEm={4.7} points={puntos} />
	</PageIntro>

	<section id="charlas" class="section section--tinted section--after-intro">
		<div class="container">
			<Tabs
				label="Hablando nuestro trabajo"
				tabs={[
					{ id: 'presentacion', label: 'Presentación' },
					{ id: 'artefacto', label: 'Artefacto' },
				]}
				initial="presentacion"
				align="center"
			>
				<TabPanel id="presentacion">
					<div class="deck">
						<iframe
							class="deck__frame"
							src={urlPresentacion}
							title="Presentación «Hablando nuestro trabajo»"
							loading="lazy"
							allow="fullscreen"></iframe>
						<a
							class="deck__full"
							href={urlPresentacion}
							target="_blank"
							rel="noopener"
							aria-label="Ver la presentación en pantalla completa"
							title="Pantalla completa"
							data-fullscreen
						>
							<svg
								viewBox="0 0 24 24"
								width="20"
								height="20"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
							</svg>
						</a>
					</div>
				</TabPanel>

				<TabPanel id="artefacto">
					<FeatureBand
						title={revisaTuPitch.titulo}
						text="Cuéntale tu idea y a quién se la vas a presentar, y recibe una guía para antes, durante y después de tu presentación: qué decir, cómo ordenarlo y cómo llegar con calma y confianza."
						tone="white"
					>
						<Fragment slot="actions">
							<Button href={revisaTuPitch.url} external icon>Usar artefacto</Button>
						</Fragment>
						<Fragment slot="media">
							<DeviceMockup
								address="claude.ai/artifact · Hablando nuestro trabajo"
								label="Demostración paso a paso de la herramienta «Revisa tu pitch», en escritorio."
								steps={pasosDemo}
							/>
						</Fragment>
					</FeatureBand>
				</TabPanel>
			</Tabs>
		</div>
	</section>

	<CtaBand title="¿Quieres una charla o taller para tu equipo?" layout="centered">
		<svg
			slot="icon"
			viewBox="0 0 32 32"
			width="40"
			height="40"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<!-- microphone -->
			<rect x="11" y="3" width="10" height="16" rx="5"></rect>
			<path d="M7 15a9 9 0 0 0 18 0M16 24v5M11.5 29h9M11 9h3M11 13h3"></path>
		</svg>
		<p class="cta-mail">
			Escríbeme un correo a <a href={`mailto:${perfil.email}`}>{perfil.email}</a>
		</p>
	</CtaBand>
</BaseLayout>

<script>
	// With the Fullscreen API, the button puts the embedded deck in fullscreen;
	// without it, the link simply opens the deck in a new tab.
	document.querySelectorAll<HTMLAnchorElement>('[data-fullscreen]').forEach((link) => {
		const frame = link.closest('.deck')?.querySelector('iframe');
		if (!frame || !document.fullscreenEnabled) return;
		link.addEventListener('click', (e) => {
			e.preventDefault();
			frame.requestFullscreen().catch(() => window.open(link.href, '_blank', 'noopener'));
		});
	});
</script>

<style>
	.cta-mail {
		color: var(--ink-muted);
		font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
	}
	.cta-mail a {
		color: var(--violet-ink);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.2em;
		overflow-wrap: anywhere;
	}

	.deck {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: calc(var(--radius) * 1.25);
		background: var(--surface);
	}
	.deck__frame {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		max-height: 80vh;
		border: 0;
	}
	.deck__full {
		position: absolute;
		/* Bottom corner: the deck's own DARK / LIGHT switch owns the top-right one. */
		bottom: 0.75rem;
		right: 0.75rem;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		background: var(--violet-600);
		color: #fff;
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.15);
		transition: transform 0.15s ease;
	}
	.deck__full:hover {
		transform: scale(1.06);
	}
	.deck__full:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 3px;
	}
	@media (prefers-reduced-motion: reduce) {
		.deck__full {
			transition: none;
		}
	}
</style>
