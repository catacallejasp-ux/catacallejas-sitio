---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada · Cata Callejas">
	<section class="container section not-found">
		<p class="eyebrow">Error 404</p>
		<h1 class="section-title">Esta página no existe</h1>
		<p>Puede que el enlace esté roto o que la página se haya movido.</p>
		<a class="button button--primary" href="/">Volver al inicio</a>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: grid;
		justify-items: start;
		gap: 1rem;
		min-height: 60vh;
		align-content: center;
	}
</style>
