---
/** One article of «Palabras», read on the site. */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { perfil } from '../../data/cv';
import { getPalabras, urlPalabra, fechaLarga, isoDate } from '../../lib/palabras';

export async function getStaticPaths() {
	const items = await getPalabras();
	return items.map((item, i) => ({
		params: { id: item.id },
		props: { item, otros: items.filter((_, j) => j !== i).slice(0, 2) },
	}));
}

const { item, otros } = Astro.props;
const { data } = item;
const { Content } = await render(item);
const site = Astro.site;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: data.title,
	description: data.description,
	datePublished: isoDate(data.date),
	inLanguage: 'es-CL',
	keywords: data.tags.join(', '),
	timeRequired: `PT${data.readingMinutes}M`,
	author: {
		'@type': 'Person',
		name: perfil.nombre,
		...(site ? { url: site.href } : {}),
	},
	...(site
		? {
				url: new URL(urlPalabra(item.id), site).href,
				mainEntityOfPage: new URL(urlPalabra(item.id), site).href,
				image: new URL(data.cover.src, site).href,
			}
		: {}),
	...(data.original ? { isBasedOn: data.original.url } : {}),
};
---

<BaseLayout
	title={`${data.title} · ${perfil.nombre}`}
	description={data.description}
	current="palabras"
	jsonLd={jsonLd}
>
	<article class="post">
		<!-- Like the project pages: back link, then the cover with the title over it. -->
		<header class="intro">
			<div class="intro__glow" aria-hidden="true"></div>
			<div class="container intro__inner">
				<a class="back text-link" href="/palabras"><Icon name="arrow-left" /> Volver a Palabras</a>
				<figure class="hero">
					<div class="hero__frame">
						<Image
							class="hero__img"
							src={data.cover}
							alt={data.coverAlt}
							widths={[640, 1200, 1800]}
							sizes="(max-width: 74rem) 100vw, 74rem"
							loading="eager"
							fetchpriority="high"
							style={`object-position: ${data.coverFocus ?? '50% 50%'}`}
						/>
						<div class="hero__text">
							<ul class="chips hero__tags" aria-label="Temas">
								{data.tags.map((t) => <li class="chip chip--strong">{t}</li>)}
							</ul>
							<h1 class="hero__title">{data.title}</h1>
						</div>
					</div>
					{
						data.coverCredit && (
							<figcaption class="hero__credit">
								Foto de{' '}
								<a href={data.coverCredit.url} target="_blank" rel="noopener">
									{data.coverCredit.name}
									<span class="visually-hidden"> (se abre en otra pestaña)</span>
								</a>{' '}
								en Unsplash
							</figcaption>
						)
					}
				</figure>
			</div>
		</header>

		<div class="container post__head">
			{data.mostrarBajada && <p class="post__lead">{data.description}</p>}
			<p class="post__meta">
				<span>Por {perfil.nombre}</span>
				<span aria-hidden="true">·</span>
				<time datetime={isoDate(data.date)}>{fechaLarga(data.date)}</time>
				<span aria-hidden="true">·</span>
				<span>{data.readingMinutes} min de lectura</span>
			</p>
		</div>

		<div class="container post__body">
			<div class="prose">
				<Content />
			</div>

			{
				data.original && (
					<p class="post__original">
						Publicado originalmente en{' '}
						<a href={data.original.url} target="_blank" rel="noopener">
							{data.original.name}
							<span class="visually-hidden"> (se abre en otra pestaña)</span>
						</a>
						.
					</p>
				)
			}
		</div>
	</article>

	{
		otros.length > 0 && (
			<aside class="container more" aria-labelledby="mas-palabras">
				<h2 id="mas-palabras" class="more__title">
					Más <span class="gradient-text">palabras</span>
				</h2>
				<ul class="more__list">
					{otros.map((o) => (
						<li>
							<a class="more__item" href={urlPalabra(o.id)}>
								<span class="more__name">{o.data.title}</span>
								<span class="more__tags">{o.data.tags.join(', ')}</span>
								<Icon name="arrow-right" />
							</a>
						</li>
					))}
				</ul>
				<a class="text-link" href="/palabras">
					Ver todas las palabras
				</a>
			</aside>
		)
	}
</BaseLayout>

<script>
	import { montarEsquemas } from '../../scripts/esquemas';
	montarEsquemas();
</script>

<style>
	/* ---- Header: same structure as the project pages (DetalleLayout). ---- */
	.intro {
		position: relative;
		overflow-x: clip;
		padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
		background: var(--lavender-50);
		border-bottom: 1px solid var(--line);
	}
	.intro__glow {
		position: absolute;
		inset: 0;
		background: var(--glow);
	}
	.intro__inner {
		position: relative;
	}
	.back {
		margin-bottom: 1.25rem;
	}
	.hero__frame {
		position: relative;
		overflow: hidden;
		border-radius: calc(var(--radius) * 1.6);
		box-shadow: 0 24px 44px -28px rgb(65 51 166 / 0.5);
	}
	.hero__frame :global(.hero__img) {
		display: block;
		width: 100%;
		height: clamp(18rem, 42vw, 34rem);
		object-fit: cover;
	}
	/*
		Title straight on the photo (no panel), white over a dark violet scrim rising
		from the bottom. The scrim is ≥ 0.7 opaque over the title's area (bottom 45%),
		so white text stays ≥ 4.5:1 even over a pure white photo (measured, nov 2026).
	*/
	.hero__frame::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			rgb(25 22 58 / 0.9) 0%,
			rgb(25 22 58 / 0.75) 40%,
			rgb(25 22 58 / 0.3) 70%,
			transparent 90%
		);
		pointer-events: none;
	}
	.hero__text {
		position: absolute;
		z-index: 1;
		inset: auto 0 0;
		padding: clamp(1.25rem, 4vw, 2.5rem);
		color: #fff;
	}
	.hero__title {
		margin-top: 0.85rem;
		max-width: 22ch;
		color: #fff;
		font-size: clamp(1.75rem, 1rem + 3vw, 3rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.035em;
		text-wrap: balance;
		text-shadow: 0 2px 18px rgb(25 22 58 / 0.45);
	}
	.hero__credit {
		margin-top: 0.6rem;
		font-size: 0.8rem;
		color: var(--ink-muted);
		text-align: right;
	}
	.hero__credit a {
		color: inherit;
	}

	/* The whole article uses the site container (74rem), same width as the project pages. */
	.post__head {
		padding-top: clamp(2rem, 4vw, 3rem);
	}
	.post__lead {
		font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
		color: var(--ink-muted);
	}
	.post__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		margin-top: 1.25rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.post__meta:first-child {
		margin-top: 0;
	}

	.post__body {
		padding-block: clamp(2rem, 5vw, 3.5rem);
	}
	/* Markdown body — styles target generated HTML, so they must be global. */
	.prose {
		font-size: 1.075rem;
		line-height: 1.75;
	}
	.prose :global(h2) {
		font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
		letter-spacing: -0.02em;
		margin-top: 2.75rem;
		margin-bottom: 0.5rem;
	}
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		margin-top: 1rem;
		color: var(--ink-body);
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.25rem;
	}
	.prose :global(li + li) {
		margin-top: 0.4rem;
	}
	.prose :global(li::marker) {
		color: var(--violet-accent);
	}
	.prose :global(strong) {
		color: var(--ink);
		font-weight: 650;
	}
	.prose :global(a) {
		color: var(--violet-ink);
		text-underline-offset: 0.15em;
		overflow-wrap: anywhere;
	}
	.prose :global(img) {
		width: 100%;
		height: auto;
		margin-top: 2rem;
		border-radius: var(--radius-sm);
	}
	/* Caption: the italic line right after an image. */
	.prose :global(p:has(img) + p > em:only-child) {
		display: block;
		margin-top: -0.4rem;
		font-size: 0.875rem;
		font-style: normal;
		text-align: center;
		color: var(--ink-muted);
	}
	/* Sources as an accordion (<details class="fuentes"> in the Markdown). */
	.prose :global(details.fuentes) {
		margin-top: 2.75rem;
		padding-inline: clamp(1rem, 2.5vw, 1.5rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
	}
	.prose :global(details.fuentes summary) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1rem;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.35rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
		cursor: pointer;
		list-style: none;
	}
	.prose :global(details.fuentes summary::-webkit-details-marker) {
		display: none;
	}
	/* chevron that turns when it opens */
	.prose :global(details.fuentes summary::after) {
		content: '';
		flex: none;
		width: 0.6rem;
		height: 0.6rem;
		margin-right: 0.15rem;
		border-right: 2px solid var(--violet-accent);
		border-bottom: 2px solid var(--violet-accent);
		transform: translateY(-0.15rem) rotate(45deg);
		transition: transform 0.2s ease;
	}
	.prose :global(details.fuentes[open] summary::after) {
		transform: translateY(0.15rem) rotate(-135deg);
	}
	.prose :global(details.fuentes > ul) {
		margin-top: 0;
		padding-bottom: 1.25rem;
		font-size: 0.95rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.prose :global(details.fuentes summary::after) {
			transition: none;
		}
	}

	/* Animated diagrams (src/scripts/esquemas.ts draws the canvas inside). */
	.prose :global(.esquema) {
		margin-block: 2.5rem;
	}
	/* All the same size: small and centred, so they accompany the reading
	   instead of taking over the screen. */
	.prose :global(.esquema__lienzo) {
		display: block;
		width: 100%;
		max-width: 34rem;
		margin-inline: auto;
		aspect-ratio: 2 / 1;
	}
	/* Sísifo's mountain and the net run edge to edge, as wide as the text. */
	.prose :global(.esquema[data-esquema='sisifo'] .esquema__lienzo) {
		max-width: none;
		aspect-ratio: 4 / 1;
	}
	.prose :global(.esquema[data-esquema='red'] .esquema__lienzo) {
		max-width: none;
		aspect-ratio: 7 / 2;
	}
	@media (max-width: 560px) {
		.prose :global(.esquema__lienzo) {
			aspect-ratio: 16 / 10;
		}
		.prose :global(.esquema[data-esquema='sisifo'] .esquema__lienzo) {
			aspect-ratio: 5 / 2;
		}
		.prose :global(.esquema[data-esquema='red'] .esquema__lienzo) {
			aspect-ratio: 2 / 1;
		}
	}
	.prose :global(.esquema figcaption) {
		margin-top: 0.5rem;
		padding-inline: 0.5rem;
		font-size: 0.875rem;
		text-align: center;
		color: var(--ink-muted);
	}

	.post__original {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
		font-size: 0.9rem;
		color: var(--ink-muted);
	}
	.post__original a {
		color: var(--violet-ink);
	}

	.more {
		padding-bottom: clamp(3rem, 7vw, 6rem);
	}
	.more__title {
		font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
		letter-spacing: -0.02em;
	}
	.more__list {
		list-style: none;
		padding: 0;
		margin-block: 1rem 1.5rem;
	}
	.more__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.25rem 1rem;
		align-items: center;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
	}
	.more__item:hover {
		border-color: var(--violet-300);
	}
	.more__item :global(svg) {
		grid-row: 1 / span 2;
		grid-column: 2;
		color: var(--violet-accent);
	}
	.more__name {
		font-weight: 600;
	}
	.more__tags {
		font-size: 0.85rem;
		color: var(--ink-muted);
	}
</style>
