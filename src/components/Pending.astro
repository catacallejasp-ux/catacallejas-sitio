---
/**
 * Visible, sober marker for content the author has not provided yet.
 * Every usage must sit next to a `TODO(content)` comment in code.
 */
interface Props {
	label: string;
	block?: boolean;
}
const { label, block = false } = Astro.props;
---

{
	block ? (
		<div class="pending pending--block" role="note">
			Pendiente: {label}
		</div>
	) : (
		<span class="pending" role="note">
			Pendiente: {label}
		</span>
	)
}

<style>
	.pending--block {
		display: grid;
		place-items: center;
		text-align: center;
		width: 100%;
		height: 100%;
		min-height: 8rem;
		padding: 1rem;
	}
</style>
