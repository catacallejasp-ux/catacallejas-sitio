---
/**
 * Swipeable image carousel: one image at a time, native scroll-snap (touch, trackpad,
 * keyboard on the focused track). With JS: previous / next buttons, one dot per image
 * and mouse drag; it loops (after the last image comes the first). Without JS the images still scroll sideways.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
	/** Optional: without it the carousel follows the text above it with no heading. */
	titulo?: string;
	imagenes: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { titulo, imagenes } = Astro.props;
const label = titulo ?? 'Imágenes del proyecto';
const id = `galeria-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section
	class="gallery"
	aria-labelledby={titulo ? id : undefined}
	aria-label={titulo ? undefined : label}
	data-gallery
>
	{titulo && <h2 id={id}>{titulo}</h2>}
	<ul class="gallery__track" tabindex="0" aria-label={`${label}: imágenes`} data-gallery-track>
		{
			imagenes.map((img, i) => (
				<li class="gallery__slide" aria-label={`${i + 1} de ${imagenes.length}`}>
					<figure>
						<Image
							src={img.src}
							alt={img.alt}
							widths={[800, 1400, 2000]}
							sizes="(max-width: 72rem) 100vw, 72rem"
						/>
						{img.caption && <figcaption>{img.caption}</figcaption>}
					</figure>
				</li>
			))
		}
	</ul>
	<div class="gallery__controls" data-gallery-controls hidden>
		<button type="button" class="gallery__btn" data-dir="-1" aria-label="Imagen anterior">
			<Icon name="arrow-left" />
		</button>
		<div class="gallery__dots">
			{
				imagenes.map((img, i) => (
					<button
						type="button"
						class="gallery__dot"
						data-i={i}
						aria-label={`Ir a la imagen ${i + 1}: ${img.alt}`}
					/>
				))
			}
		</div>
		<button type="button" class="gallery__btn" data-dir="1" aria-label="Imagen siguiente">
			<Icon name="arrow-right" />
		</button>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('[data-gallery-track]')!;
		const controls = root.querySelector<HTMLElement>('[data-gallery-controls]')!;
		const slides = [...track.children] as HTMLElement[];
		const dots = [...root.querySelectorAll<HTMLButtonElement>('.gallery__dot')];
		const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.gallery__btn');
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (slides.length < 2) return;
		controls.hidden = false;

		const current = () => Math.round(track.scrollLeft / track.clientWidth);
		const goTo = (i: number) =>
			track.scrollTo({
				left: Math.max(0, Math.min(slides.length - 1, i)) * track.clientWidth,
				behavior: reduce ? 'auto' : 'smooth',
			});
		const last = slides.length - 1;
		const update = () => {
			const at = current();
			dots.forEach((d, i) => d.setAttribute('aria-current', String(i === at)));
		};
		// Infinite: past the last image comes the first, and before the first, the last.
		const step = (dir: number) => {
			const at = current();
			goTo(dir > 0 ? (at >= last ? 0 : at + 1) : at <= 0 ? last : at - 1);
		};
		prev.addEventListener('click', () => step(-1));
		next.addEventListener('click', () => step(1));
		dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
		track.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
		update();

		// Swiping past either end wraps around (touch and mouse).
		const wrapIfPastEdge = (fromScroll: number, dx: number) => {
			const max = track.scrollWidth - track.clientWidth - 2;
			if (fromScroll >= max && dx < -40) return (goTo(0), true);
			if (fromScroll <= 2 && dx > 40) return (goTo(last), true);
			return false;
		};
		let touchX = 0;
		let touchScroll = 0;
		track.addEventListener(
			'touchstart',
			(e) => {
				touchX = e.touches[0].clientX;
				touchScroll = track.scrollLeft;
			},
			{ passive: true },
		);
		track.addEventListener(
			'touchend',
			(e) => wrapIfPastEdge(touchScroll, e.changedTouches[0].clientX - touchX),
			{ passive: true },
		);

		// Mouse drag (touch already swipes natively).
		let startX = 0;
		let startScroll = 0;
		let dragging = false;
		track.addEventListener('pointerdown', (e) => {
			if (e.pointerType !== 'mouse' || e.button !== 0) return;
			dragging = true;
			startX = e.clientX;
			startScroll = track.scrollLeft;
			track.classList.add('is-dragging');
		});
		window.addEventListener('pointermove', (e) => {
			if (dragging) track.scrollLeft = startScroll - (e.clientX - startX);
		});
		window.addEventListener('pointerup', (e) => {
			if (!dragging) return;
			dragging = false;
			track.classList.remove('is-dragging');
			if (!wrapIfPastEdge(startScroll, e.clientX - startX)) goTo(current());
		});
	});
</script>

<style>
	.gallery h2 {
		font-size: 1.6rem;
	}
	.gallery__track {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 100%;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		border-radius: var(--radius);
		cursor: grab;
	}
	.gallery__track::-webkit-scrollbar {
		display: none;
	}
	.gallery__track.is-dragging {
		scroll-snap-type: none;
		cursor: grabbing;
	}
	.gallery__track:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 4px;
	}
	.gallery__slide {
		scroll-snap-align: start;
		min-width: 0;
	}
	.gallery__slide figure {
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}
	.gallery__slide :global(img) {
		display: block;
		width: 100%;
		height: clamp(16rem, 42vw, 34rem);
		object-fit: contain;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		pointer-events: none;
		-webkit-user-drag: none;
		user-select: none;
	}
	/* Each image's description: readable size, centred under it. */
	.gallery__slide figcaption {
		max-width: 62ch;
		margin-inline: auto;
		text-align: center;
		font-size: clamp(1rem, 0.95rem + 0.2vw, 1.1rem);
		color: var(--ink-muted);
	}
	.gallery:not(:has(h2)) .gallery__track {
		margin-top: 0;
	}
	.gallery__controls {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-top: 1rem;
	}
	.gallery__controls[hidden] {
		display: none;
	}
	.gallery__btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--violet);
		border-radius: 999px;
		background: var(--surface);
		color: var(--violet-ink);
		font-size: 1.1rem;
		cursor: pointer;
	}
	.gallery__btn:hover {
		background: var(--violet);
		color: #fff;
	}
	.gallery__btn:focus-visible,
	.gallery__dot:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 2px;
	}
	.gallery__dots {
		display: flex;
		gap: 0.15rem;
	}
	.gallery__dot {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: none;
		cursor: pointer;
	}
	.gallery__dot::before {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 999px;
		background: var(--violet-300);
		transition: width 0.2s ease;
	}
	.gallery__dot[aria-current='true']::before {
		width: 22px;
		background: var(--violet);
	}
	@media (prefers-reduced-motion: reduce) {
		.gallery__dot::before {
			transition: none;
		}
	}
</style>
