---
/**
 * Band with a fixed label and a slow scrolling row of client logos (inline SVG,
 * coloured with CSS). A pause button covers WCAG 2.2.2; it also pauses on hover and
 * is a static grid with prefers-reduced-motion.
 * Screen readers get the list once: the duplicated copy used for the loop is hidden.
 */
interface Logo {
	file: string;
	nombre: string;
}
interface Props {
	label: string;
	logos: Logo[];
}
const { label, logos } = Astro.props;

const files = import.meta.glob<string>('../assets/logos/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
});

// Same visual weight for very different shapes: constant area, clamped height.
const items = logos.map((logo) => {
	const raw = files[`../assets/logos/${logo.file}.svg`];
	if (!raw) throw new Error(`Logo not found: src/assets/logos/${logo.file}.svg`);
	const [, w, h] = raw.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/) ?? [];
	const ratio = Number(w) / Number(h) || 3;
	const height = Math.max(26, Math.min(44, Math.sqrt(4600 / ratio)));
	// Replace the file's own label with the name we show, so both always match.
	const svg = raw
		.replace(/\saria-label="[^"]*"/, '')
		.replace('<svg', `<svg aria-label="${logo.nombre}" focusable="false"`);
	return { ...logo, svg, height: Math.round(height) };
});
---

<section class="logos" aria-labelledby="logos-label">
	<div class="logos__inner">
		<p id="logos-label" class="logos__label">
			<span class="logos__star" aria-hidden="true">✦</span>
			{label}
		</p>
		<div class="logos__viewport">
			<ul class="logos__track">
				{
					[0, 1].map((copy) =>
						items.map((item) => (
							<li
								class="logos__item"
								aria-hidden={copy === 1 ? 'true' : undefined}
								style={`--h: ${item.height}px`}
								set:html={item.svg}
							/>
						)),
					)
				}
			</ul>
		</div>
		<button class="logos__pause" type="button" aria-pressed="false" hidden>
			<span class="visually-hidden">Pausar animación de logos</span>
			<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
				<path
					class="logos__icon-pause"
					d="M7 5v10M13 5v10"
					stroke="currentColor"
					stroke-width="2.2"
					stroke-linecap="round"></path>
				<path class="logos__icon-play" d="M7 5l8 5-8 5z" fill="currentColor"></path>
			</svg>
		</button>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.logos').forEach((band) => {
		const button = band.querySelector<HTMLButtonElement>('.logos__pause');
		if (!button) return;
		button.hidden = false;
		const label = button.querySelector('.visually-hidden')!;
		button.addEventListener('click', () => {
			const paused = button.getAttribute('aria-pressed') !== 'true';
			button.setAttribute('aria-pressed', String(paused));
			band.classList.toggle('is-paused', paused);
			label.textContent = paused ? 'Reanudar animación de logos' : 'Pausar animación de logos';
		});
	});
</script>

<style>
	/* Transparent band. Logos --violet-600 (5.04:1 on the page bg), label and star
	   --teal-800 (6.13:1). */
	.logos {
		background: transparent;
		color: var(--violet-600);
	}
	.logos__inner {
		display: flex;
		align-items: center;
		gap: 1.25rem clamp(1.5rem, 4vw, 3rem);
		padding-block: 1.5rem;
		padding-left: max(var(--gutter), (100% - var(--max)) / 2);
	}
	.logos__label {
		flex: none;
		font-family: var(--font-display);
		font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem);
		font-weight: 500;
		color: var(--teal-800);
		white-space: nowrap;
	}
	.logos__label {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}
	.logos__star {
		color: var(--teal-800);
		font-size: 1.1em;
	}
	.logos__viewport {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		/* Soft fade at the edges. */
		mask-image: linear-gradient(90deg, transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
	}
	.logos__track {
		display: flex;
		align-items: center;
		width: max-content;
		list-style: none;
		padding: 0;
		animation: logos 45s linear infinite;
	}
	.logos__item {
		display: flex;
		align-items: center;
		height: 52px;
		padding-right: clamp(2.5rem, 5vw, 4rem);
	}
	.logos__item :global(svg) {
		display: block;
		height: var(--h);
		width: auto;
	}
	.logos__viewport:hover .logos__track,
	.is-paused .logos__track {
		animation-play-state: paused;
	}
	.logos__pause {
		flex: none;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-right: var(--gutter);
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--violet-700);
		box-shadow: inset 0 0 0 1.5px var(--violet-600);
		cursor: pointer;
	}
	.logos__pause:hover {
		background: var(--violet-50);
	}
	.logos__pause:focus-visible {
		outline-color: var(--violet-600);
	}
	.logos__icon-play,
	.is-paused .logos__icon-pause {
		display: none;
	}
	.is-paused .logos__icon-play {
		display: inline;
	}
	@keyframes logos {
		to {
			transform: translateX(-50%);
		}
	}
	@media (max-width: 47.99rem) {
		.logos__inner {
			flex-wrap: wrap;
		}
		.logos__label {
			flex: 1;
		}
		.logos__viewport {
			order: 3;
			flex-basis: 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.logos__track {
			animation: none;
			flex-wrap: wrap;
			width: auto;
			row-gap: 1rem;
		}
		.logos__item[aria-hidden='true'] {
			display: none;
		}
		.logos__viewport {
			mask-image: none;
			padding-right: var(--gutter);
		}
		.logos__pause {
			display: none;
		}
	}
</style>
