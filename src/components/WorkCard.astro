---
/**
 * Project card (About page carousel). The cover fills the whole card and a dark violet
 * shade rises from the bottom (same treatment as the article covers in «Palabras»),
 * with the number, title, role tags and «Leer caso» in white over it.
 * The whole card is one link; «Leer caso» is styled as a button inside it.
 * Contrast: the shade is ≥ 0.7 opaque over the text area, so white text stays ≥ 4.5:1
 * even over a white photo.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Pending from './Pending.astro';

interface Props {
	n: number;
	title: string;
	tags?: string[];
	href: string;
	cover?: ImageMetadata;
	coverAlt?: string;
	/** CSS object-position for the cover, so the person or action stays in view. */
	coverFocus?: string;
	id?: string;
}
const { n, title, tags = [], href, cover, coverAlt, coverFocus = '50% 50%', id } = Astro.props;
---

<a class="work" href={href} id={id} draggable="false">
	<div class="work__media" style={`--focus: ${coverFocus}`}>
		{
			cover ? (
				<Image
					src={cover}
					alt={coverAlt ?? ''}
					widths={[600, 900, 1300]}
					sizes="(max-width: 560px) 130vw, 640px"
					loading="lazy"
				/>
			) : (
				/* TODO(content): portada — while missing, a placeholder shows. */
				<Pending label={`portada de ${title}`} block />
			)
		}
	</div>
	<div class="work__body">
		<p class="work__n" aria-hidden="true">{String(n).padStart(2, '0')}</p>
		<h3 class="work__title">{title}</h3>
		{
			tags.length > 0 && (
				<ul class="work__tags" aria-label="Roles">
					{tags.map((t) => (
						<li>{t}</li>
					))}
				</ul>
			)
		}
		<span class="button button--sm work__cta">Leer caso</span>
	</div>
</a>

<style>
	.work {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		height: 100%;
		min-height: 27rem;
		overflow: hidden;
		border-radius: calc(var(--radius) * 1.6);
		background: var(--surface-deep-2);
		color: #fff;
		text-decoration: none;
		box-shadow: 0 24px 44px -26px rgb(65 51 166 / 0.55);
		scroll-margin-top: 6rem;
		-webkit-user-drag: none;
		user-select: none;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	.work:hover {
		transform: translateY(-4px);
		box-shadow: 0 30px 50px -26px rgb(65 51 166 / 0.65);
	}
	.work:focus-visible {
		outline: 3px solid var(--violet);
		outline-offset: 4px;
	}

	/* The photo fills the card. */
	.work__media {
		position: absolute;
		inset: 0;
		z-index: -2;
	}
	.work__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--focus);
		-webkit-user-drag: none;
		pointer-events: none;
		transition: transform 0.5s ease;
	}
	.work:hover .work__media :global(img) {
		transform: scale(1.04);
	}
	.work__media :global(.pending) {
		height: 62%;
		border: 0;
		background: transparent;
	}

	/* Dark violet shade rising from the bottom, under the text. */
	.work::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(
			to top,
			rgb(25 22 58 / 0.94) 0%,
			rgb(25 22 58 / 0.82) 38%,
			rgb(25 22 58 / 0.45) 62%,
			transparent 85%
		);
		pointer-events: none;
	}

	.work__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		padding: 1.4rem 1.25rem 1.25rem;
		text-align: left;
	}
	.work__n {
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--teal-200);
	}
	.work__title {
		color: #fff;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-wrap: balance;
	}
	.work__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding: 0;
		list-style: none;
	}
	/* Tags are small squared labels, not pills, so they don't read as buttons. */
	.work__tags li {
		padding: 0.2rem 0.5rem;
		border-radius: 6px;
		background: rgb(255 255 255 / 0.14);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
		color: #fff;
		font-size: 0.9rem;
		font-weight: 500;
	}
	/* White outline button on the shade; fills white on card hover. */
	.work__cta {
		align-self: flex-end;
		margin-top: 0.6rem;
		color: #fff;
		font-weight: 600;
		background: transparent;
		box-shadow: inset 0 0 0 1.5px #fff;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.work:hover .work__cta {
		background: #fff;
		color: var(--violet-900);
	}
	@media (prefers-reduced-motion: reduce) {
		.work,
		.work__media :global(img) {
			transition: none;
		}
		.work:hover,
		.work:hover .work__media :global(img) {
			transform: none;
		}
	}
</style>
