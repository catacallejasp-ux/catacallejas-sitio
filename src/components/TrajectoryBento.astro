---
/**
 * «Conoce mi trayectoria» as a bento grid of glass tiles over soft colour
 * blobs (moodboard reference). Main tile first in the DOM so the heading leads.
 * Contrast: --ink / --violet-800 text on light glass ≥ 5.8:1 even over a blob;
 * white on the deep tile (--violet-800 at 92%) ≥ 7:1.
 */
import Button from './Button.astro';
import DownloadCv from './DownloadCv.astro';
import { trayectoriaResumen as t } from '../data/cv';

const arrow = 'M4 10h12M11 5l5 5-5 5';
---

<section class="traj" aria-labelledby="trayectoria">
	<span class="traj__blob traj__blob--violet" aria-hidden="true"></span>
	<span class="traj__blob traj__blob--teal" aria-hidden="true"></span>
	<div class="container traj__grid">
		<div class="tile tile--frost tile--main">
			<h2 id="trayectoria" class="tile__heading">Conoce mi trayectoria</h2>
			<p class="tile__label">He trabajado en:</p>
			<ul class="chips tile__chips">
				{t.rubros.map((r) => <li class="chip">{r}</li>)}
			</ul>
			<div class="tile__actions">
				<Button href="/sobre-mi" icon>Sobre mí</Button>
				<DownloadCv variant="ghost" label="Descargar CV" />
			</div>
		</div>

		<a class="tile tile--lilac tile--exp" href="/sobre-mi#trayectoria">
			<span class="tile__arrow" aria-hidden="true">
				<svg viewBox="0 0 20 20" width="18" height="18"
					><path
						d={arrow}
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"></path></svg
				>
			</span>
			<span class="tile__figure">
				<span class="tile__value">{t.experiencia.valor}</span>
				<span class="tile__unit">{t.experiencia.unidad}</span>
			</span>
			<span class="tile__caption">{t.experiencia.texto}</span>
			<span class="visually-hidden">: ver mi trayectoria</span>
		</a>

		<a class="tile tile--sky tile--companies" href="/sobre-mi#proyectos">
			<span class="tile__arrow" aria-hidden="true">
				<svg viewBox="0 0 20 20" width="18" height="18"
					><path
						d={arrow}
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"></path></svg
				>
			</span>
			<span class="tile__figure">
				<span class="tile__value">{t.empresas.valor}</span>
				<span class="tile__unit">{t.empresas.unidad}</span>
			</span>
			<span class="tile__caption">{t.empresas.texto}</span>
			<span class="visually-hidden">: ver mis proyectos</span>
		</a>

		<div class="tile tile--deep tile--vol">
			<span class="tile__rings" aria-hidden="true"></span>
			<span class="tile__figure">
				<span class="tile__value">{t.voluntariado.valor}</span>
				<span class="tile__unit">{t.voluntariado.unidad}</span>
			</span>
			<span class="tile__caption">{t.voluntariado.texto}</span>
			<span class="tile__detail">{t.voluntariado.detalle}</span>
		</div>
	</div>
</section>

<style>
	.traj {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		padding-bottom: clamp(1rem, 3vw, 2rem);
	}
	.traj__blob {
		position: absolute;
		z-index: -1;
		border-radius: 50%;
		filter: blur(70px);
		opacity: 0.7;
		pointer-events: none;
		animation: traj-drift 20s ease-in-out infinite alternate;
	}
	.traj__blob--violet {
		width: min(40vw, 520px);
		aspect-ratio: 1.2;
		left: 8%;
		top: 10%;
		background: var(--violet-300);
	}
	.traj__blob--teal {
		width: min(34vw, 440px);
		aspect-ratio: 1;
		right: 18%;
		bottom: 0;
		background: var(--teal-300);
		animation-direction: alternate-reverse;
	}
	@keyframes traj-drift {
		to {
			transform: translate(6%, -8%) scale(1.1);
		}
	}

	.traj__grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: minmax(0, 1fr);
		grid-template-areas: 'main' 'exp' 'companies' 'vol';
	}
	@media (min-width: 640px) {
		.traj__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-areas: 'main main' 'exp companies' 'vol vol';
		}
	}
	@media (min-width: 1000px) {
		.traj__grid {
			grid-template-columns: 1.4fr 1.1fr 1.1fr;
			grid-template-areas: 'main main exp' 'main main companies' 'vol vol vol';
		}
	}
	@media (min-width: 1200px) {
		.traj__grid {
			grid-template-columns: 1.35fr 1fr 0.9fr;
			grid-template-areas: 'main exp vol' 'main companies vol';
		}
	}
	.tile--main {
		grid-area: main;
	}
	.tile--exp {
		grid-area: exp;
	}
	.tile--companies {
		grid-area: companies;
	}
	.tile--vol {
		grid-area: vol;
	}

	/* Glass tile */
	.tile {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-height: 11rem;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		border-radius: var(--radius);
		border: 1px solid var(--edge);
		background: var(--glass);
		box-shadow:
			inset 0 1px 0 var(--edge),
			0 18px 40px -22px rgb(65 51 166 / 0.35);
		-webkit-backdrop-filter: blur(14px) saturate(140%);
		backdrop-filter: blur(14px) saturate(140%);
		color: var(--ink);
		text-decoration: none;
	}
	.tile--frost {
		--glass: color-mix(in srgb, var(--paper) 60%, transparent);
	}
	.tile--lilac {
		--glass: color-mix(in srgb, var(--violet-200) 60%, transparent);
	}
	.tile--sky {
		--glass: color-mix(in srgb, var(--teal-200) 60%, transparent);
	}
	.tile--deep {
		--glass: rgb(65 51 166 / 0.92);
		border-color: rgb(255 255 255 / 0.25);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.3),
			0 18px 40px -22px rgb(65 51 166 / 0.6);
		color: #fff;
	}
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.tile--frost {
			--glass: var(--paper);
		}
		.tile--lilac {
			--glass: var(--violet-100);
		}
		.tile--sky {
			--glass: var(--teal-100);
		}
	}

	/* Main tile */
	.tile__heading {
		font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		max-width: 18ch;
	}
	.tile__label {
		margin-top: 0.5rem;
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--violet-800);
	}
	.tile__chips .chip {
		background: color-mix(in srgb, var(--paper) 80%, transparent);
		color: var(--violet-800);
	}
	.tile__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 1rem;
	}

	/* Figure tiles */
	.tile__figure {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		margin-top: auto;
	}
	.tile__value {
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--violet-800);
	}
	.tile__unit {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--violet-800);
	}
	.tile__caption {
		font-size: 0.98rem;
		color: var(--ink);
	}
	.tile--deep .tile__value,
	.tile--deep .tile__unit {
		color: #fff;
	}
	.tile--deep .tile__caption {
		color: #fff;
	}
	.tile__detail {
		font-size: 0.9rem;
		color: var(--on-deep-muted);
	}
	.tile__arrow {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--paper) 85%, transparent);
		color: var(--violet-800);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}
	a.tile:hover .tile__arrow,
	a.tile:focus-visible .tile__arrow {
		background: var(--violet-600);
		color: #fff;
	}
	a.tile {
		transition: transform 0.2s ease;
	}
	a.tile:hover {
		transform: translateY(-3px);
	}
	/* Decorative concentric rings, like the reference. */
	.tile__rings {
		position: absolute;
		inset: -30% -40% auto auto;
		width: 22rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: repeating-radial-gradient(
			circle,
			transparent 0 18px,
			rgb(255 255 255 / 0.1) 18px 19px
		);
		pointer-events: none;
	}
	.tile--deep > :not(.tile__rings) {
		position: relative;
	}
	@media (prefers-reduced-motion: reduce) {
		.traj__blob {
			animation: none;
		}
		a.tile:hover {
			transform: none;
		}
	}
</style>
