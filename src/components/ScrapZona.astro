---
/**
 * One half of a «Comunidades» canvas: a free-form collage (see src/data/comunidades.ts).
 * Positions are % of the half; sizes are container units (cqi = 1% of its width), so
 * the collage scales as a whole. Decorative pieces are hidden from screen readers.
 */
import { Image } from 'astro:assets';
import type { Item } from '../data/comunidades';

interface Props {
	items: Item[];
	color: string;
	/** Height / width of this half on phones (default 1.6). */
	altoMovil?: number;
}
const { items, color, altoMovil } = Astro.props;

type ConLugar = {
	x: number;
	y: number;
	w: number;
	rot?: number;
	movil?: { x?: number; y?: number; w?: number; rot?: number };
};
// Desktop placement plus optional phone placement (see `movil` in the data).
const pos = (i: ConLugar) => {
	const m = i.movil ?? {};
	return [
		`--x:${i.x}%;--y:${i.y}%;--w:${i.w}%;--rot:${i.rot ?? 0}deg`,
		m.x !== undefined ? `--mx:${m.x}%` : '',
		m.y !== undefined ? `--my:${m.y}%` : '',
		m.w !== undefined ? `--mw:${m.w}%` : '',
		m.rot !== undefined ? `--mrot:${m.rot}deg` : '',
	]
		.filter(Boolean)
		.join(';');
};
---

<div class="zona" style={`--tinta:${color}${altoMovil ? `;--alto-movil:${altoMovil}` : ''}`}>
	{
		items.map((it) => {
			switch (it.tipo) {
				case 'foto':
					return (
						<figure
							class:list={[
								's-foto',
								`s-foto--${it.marco ?? 'borde'}`,
								it.cinta && `s-foto--${it.cinta}`,
							]}
							style={`${pos(it)};--formato:${
								it.formato ??
								(['ninguno', 'pantalla', 'telefono'].includes(it.marco ?? '') ? 'auto' : 4 / 3)
							}`}
						>
							{it.marco === 'pantalla' && (
								<span class="s-foto__barra" aria-hidden="true">
									<i />
									<i />
									<i />
								</span>
							)}
							{it.clip && (
								<svg class="s-clip" viewBox="0 0 20 52" aria-hidden="true">
									<path d="M6 40V9a4 4 0 0 1 8 0v34a6 6 0 0 1-12 0V14" />
								</svg>
							)}
							<Image
								src={it.src}
								alt={it.alt}
								widths={[320, 640]}
								sizes="(min-width: 56rem) 320px, 70vw"
								loading="lazy"
							/>
							{it.pie && <figcaption>{it.pie}</figcaption>}
							{it.fecha && <span class="s-foto__fecha">{it.fecha}</span>}
						</figure>
					);
				case 'video':
					return (
						<figure
							class="s-video"
							style={`${pos(it)};--formato:${it.formato ?? 16 / 10}${
								it.movilVideo ? `;--formato-movil:${it.movilVideo.formato}` : ''
							}`}
							data-poster-movil={it.movilVideo?.poster.src}
						>
							{/* Autoplay, muted, looping: started and stopped by ScrapLienzos (only
							    on the front sheet, in view, without reduced motion). Without JS
							    the native controls stay. */}
							<video
								controls
								muted
								loop
								playsinline
								preload="metadata"
								poster={it.poster.src}
								aria-label={it.titulo}
							>
								{it.movilVideo && (
									<source media="(max-width: 55.99rem)" src={it.movilVideo.src} type="video/mp4" />
								)}
								<source src={it.src} type="video/mp4" />
							</video>
							{/* Controls top-right, like the deck button in «Hablando»: icon-only
							    violet circles, named for screen readers, with a tooltip; they
							    appear on hover or keyboard focus. */}
							<div class="s-video__controles">
								{it.grande && (
									<button
										type="button"
										class="s-video__boton"
										data-ampliar
										aria-haspopup="dialog"
										aria-label="Ver el video en grande"
										title="Ver en grande"
										hidden
									>
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
										</svg>
									</button>
								)}
								<button type="button" class="s-video__boton s-video__pausa" title="Pausar" hidden>
									<span class="visually-hidden">Pausar video</span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path class="icono-pausa" d="M8 5v14M16 5v14" />
										<path class="icono-play" d="M8 5l11 7-11 7z" />
									</svg>
								</button>
							</div>
							{it.grande && (
								<dialog class="s-modal" aria-label={it.titulo}>
									<div class="s-modal__marco">
										<button type="button" class="s-modal__cerrar" data-cerrar>
											<span class="visually-hidden">Cerrar video</span>
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M6 6l12 12M18 6 6 18" />
											</svg>
										</button>
										<video
											controls
											muted
											loop
											playsinline
											preload="none"
											poster={it.poster.src}
											data-src={it.grande}
											data-src-movil={it.movilVideo?.src}
											aria-label={it.titulo}
										/>
									</div>
								</dialog>
							)}
						</figure>
					);
				case 'nota':
					return (
						<p
							class:list={['s-nota', `s-nota--${it.papel}`]}
							style={`${pos(it)};--tam:${it.tam ?? 5}`}
						>
							{it.texto}
						</p>
					);
				case 'titulo':
					return (
						<p class="s-titulo" style={pos(it)}>
							{it.texto}
						</p>
					);
				case 'etiqueta':
					return (
						<p class="s-etiqueta" style={pos(it)}>
							{it.texto}
						</p>
					);
				case 'postal':
					return (
						<div class="s-postal" style={pos(it)}>
							<span class="s-postal__marca" aria-hidden="true">
								POSTCARD
							</span>
							<span class="s-postal__sello" aria-hidden="true" />
							<p class="s-postal__texto">{it.texto}</p>
						</div>
					);
				case 'pelicula':
					return (
						<div class="s-pelicula" style={pos(it)} role="img" aria-label={it.alt}>
							{it.fotos.map((f) => (
								<Image src={f} alt="" widths={[160, 320]} sizes="120px" loading="lazy" />
							))}
						</div>
					);
				case 'manuscrito':
					return (
						<p class="s-manuscrito" style={pos(it)}>
							{it.texto}
						</p>
					);
				case 'sticker':
					return (
						<p class="s-sticker" style={pos(it)}>
							{it.texto}
						</p>
					);
				case 'recorte':
					return (
						<Image
							class:list={['s-recorte', it.contorno && 's-recorte--contorno']}
							style={pos(it)}
							src={it.src}
							alt={it.alt}
							widths={[320, 640, 960]}
							sizes="(min-width: 56rem) 360px, 70vw"
							loading="lazy"
						/>
					);
				case 'cifra':
					return (
						<p class="s-cifra" style={pos(it)}>
							<span class="s-cifra__num">{it.numero}</span>
							<span class="s-cifra__txt">{it.texto}</span>
						</p>
					);
				case 'ficha':
					return (
						<p class="s-ficha" style={pos(it)}>
							{it.texto}
						</p>
					);
				case 'enlace':
					return (
						<a
							class="s-enlace"
							style={pos(it)}
							href={it.href}
							{...(it.externo ? { target: '_blank', rel: 'noopener' } : {})}
						>
							{it.texto}
							{it.externo && <span class="visually-hidden"> (se abre en otra pestaña)</span>}
						</a>
					);
				case 'flecha':
					return (
						<svg
							class="s-adorno s-flecha"
							style={`${pos(it)}${it.voltear ? ';--flip:-1' : ''}`}
							viewBox="0 0 100 60"
							aria-hidden="true"
						>
							{it.variante === 2 ? (
								<path d="M4 44c18-2 22-30 36-26s-6 26 10 26 26-22 44-30m0 0-10-2m10 2-4 10" />
							) : it.variante === 3 ? (
								<path d="M6 40 92 18m0 0-12-4m12 4-8 10" />
							) : (
								<path d="M6 50C26 18 58 10 92 16m0 0-11-7m11 7-9 9" />
							)}
						</svg>
					);
				case 'circulo':
					return (
						<span
							class="s-circulo"
							style={`${pos(it)};background:${it.color ?? color}`}
							aria-hidden="true"
						/>
					);
				case 'papel':
					return (
						<span
							class="s-papel"
							style={`${pos(it)};height:${it.alto ?? 20}cqi;background-color:${it.color ?? color}`}
							aria-hidden="true"
						/>
					);
				case 'sobre':
					return (
						<svg class="s-adorno" style={pos(it)} viewBox="0 0 100 68" aria-hidden="true">
							<rect x="1" y="1" width="98" height="66" rx="2" fill="#f3e7c4" stroke="#e0cf9e" />
							<path d="M1 3 50 40 99 3" fill="#f8efd4" stroke="#e0cf9e" />
							<path d="M1 66 40 34M99 66 60 34" fill="none" stroke="#e6d6a8" />
						</svg>
					);
				case 'flor':
					return (
						<svg class="s-adorno" style={pos(it)} viewBox="0 0 100 100" aria-hidden="true">
							<g transform="translate(50 50)">
								{[0, 60, 120, 180, 240, 300].map((a) => (
									<path
										transform={`rotate(${a})`}
										d="M0 0C-9-12-8-34 0-46C8-34 9-12 0 0Z"
										fill="#ec6fae"
										stroke="#c94a8c"
										stroke-width="0.8"
									/>
								))}
								{[0, 60, 120, 180, 240, 300].map((a) => (
									<path
										transform={`rotate(${a + 30})`}
										d="M0 0v-16"
										stroke="#7a2c5a"
										stroke-width="1.2"
										stroke-linecap="round"
									/>
								))}
								<circle r="5" fill="#f9d56e" />
							</g>
						</svg>
					);
				case 'margarita':
					return (
						<svg class="s-adorno" style={pos(it)} viewBox="0 0 100 100" aria-hidden="true">
							<path d="M50 60c-2 14 2 28 8 38" stroke="#7aa36b" stroke-width="2.5" fill="none" />
							<g transform="translate(50 46)">
								{Array.from({ length: 12 }, (_, i) => (
									<ellipse
										transform={`rotate(${i * 30})`}
										cy="-17"
										rx="6"
										ry="15"
										fill="#fff"
										stroke="#e4dfd3"
									/>
								))}
								<circle r="8" fill="#f2c94c" />
							</g>
						</svg>
					);
				case 'puntos':
					return (
						<svg class="s-adorno" style={pos(it)} viewBox="0 0 40 40" aria-hidden="true">
							{[
								[6, 6],
								[20, 4],
								[34, 8],
								[10, 20],
								[26, 18],
								[18, 32],
								[34, 30],
							].map(([cx, cy]) => (
								<circle cx={cx} cy={cy} r="3.4" fill={color} />
							))}
						</svg>
					);
				case 'estrella':
					return (
						<svg class="s-adorno" style={pos(it)} viewBox="0 0 50 50" aria-hidden="true">
							<path
								d="M25 3C27 21 29 23 47 25 29 27 27 29 25 47 23 29 21 27 3 25 21 23 23 21 25 3Z"
								fill="none"
								stroke="var(--azul)"
								stroke-width="2"
								stroke-linejoin="round"
							/>
						</svg>
					);
			}
		})
	}
</div>

<script>
	// Narrow screens: the phone version's poster (its <source> is chosen by media,
	// read when the video loads).
	const estrecho = window.matchMedia('(max-width: 55.99rem)');
	if (estrecho.matches) {
		for (const fig of document.querySelectorAll<HTMLElement>('[data-poster-movil]')) {
			const v = fig.querySelector<HTMLVideoElement>(':scope > video');
			if (v && fig.dataset.posterMovil) v.poster = fig.dataset.posterMovil;
		}
	}

	// Touch screens: a tap on a video shows its controls for 3 s (a tap on a control
	// keeps them up). With a mouse, hover does this in CSS.
	const tactil = window.matchMedia('(hover: none)');
	for (const fig of document.querySelectorAll<HTMLElement>('.s-video')) {
		let t: number | undefined;
		const mostrar = () => {
			fig.classList.add('is-controles');
			clearTimeout(t);
			t = window.setTimeout(() => fig.classList.remove('is-controles'), 3000);
		};
		fig.addEventListener('click', (e) => {
			if (!tactil.matches) return;
			const enBoton = (e.target as HTMLElement).closest('button');
			if (!enBoton && fig.classList.contains('is-controles')) {
				clearTimeout(t);
				fig.classList.remove('is-controles');
			} else mostrar();
		});
	}

	// «Ver en grande»: a modal <dialog> (focus stays inside, Escape closes) with a
	// larger version of the clip, downloaded only the first time it is opened. It plays
	// muted in a loop; its native controls allow pausing. Closing pauses it and returns
	// focus to the button (native <dialog> behaviour). Without JS the button stays
	// hidden and the small video keeps its native controls (including full screen).
	for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-ampliar]')) {
		const dialog = btn.closest('.s-video')!.querySelector<HTMLDialogElement>('.s-modal')!;
		const video = dialog.querySelector('video')!;
		btn.hidden = false;
		btn.addEventListener('click', () => {
			if (!video.src) {
				// Phones get the vertical version, shown in a vertical dialog.
				const movil = estrecho.matches && video.dataset.srcMovil;
				dialog.classList.toggle('is-vertical', Boolean(movil));
				video.src = movil || video.dataset.src || '';
			}
			dialog.showModal();
			video.play().catch(() => {});
		});
		const cerrar = () => dialog.close();
		dialog.querySelector('[data-cerrar]')!.addEventListener('click', cerrar);
		// A click on the dimmed backdrop lands on the dialog itself.
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) cerrar();
		});
		dialog.addEventListener('close', () => {
			video.pause();
			btn.focus();
		});
	}
</script>

<style>
	/* Ink on paper is fixed in both themes (the papers stay light). Contrast, worst case
	   over the four papers, post-its, cards and the violet grid lines (WCAG AA ≥ 4.5:1):
	   ink #2b2740 ≥ 11.7:1 · violet #31248d (the site's --brand-900) ≥ 6.9:1 · faint handwriting (ink at 72%)
	   ≥ 5.2:1 · ticket text in ink ≥ 11.7:1.
	   Body text never goes below ~12px (dates ~11px), however narrow the canvas. */
	.zona {
		--ink-papel: #2b2740;
		--azul: #31248d;
		position: relative;
		aspect-ratio: 4 / 5;
		container-type: inline-size;
		color: var(--ink-papel);
		font-family: var(--font-notas), 'Courier New', monospace;
		line-height: 1.25;
		/* Everything is regular (400) except links, in bold (700). Handlee (titles) has
		   one weight: never fake a bold. Notes are set in Courier Prime, a wide
		   typewriter face, so their sizes are scaled by --mano. */
		font-synthesis: none;
		--mano: 0.7;
		/* Every size is a share of the paper's width (cqi), with no pixel floors, so
		   the collage scales as one picture: if it fits at one width it fits at all.
		   Desktop papers are ≥ 358px wide → notes ≥ 12.5px. Phones make texts 1.5×
		   bigger in proportion: papers ≥ 227px → notes ≥ 11.9px. */
		--escala: 1;
	}
	/* The site's reset lets any word break anywhere; in the collage words stay whole
	   (post-its hyphenate instead), so a piece that is too narrow shows up as such. */
	.zona,
	.zona * {
		overflow-wrap: normal;
	}
	.zona > * {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: var(--w);
		margin: 0;
		transform: rotate(var(--rot));
	}
	/* Phones: each half is a little taller, so the collage breathes once texts hit
	   their minimum size; items can also take their own phone placement. */
	@media (max-width: 55.99rem) {
		.zona {
			aspect-ratio: 1 / var(--alto-movil, 1.6);
			--escala: 1.5;
		}
		/* Typed tapes spaced a little tighter, so long dates fit the narrower paper. */
		.zona .s-etiqueta {
			letter-spacing: 0.06em;
		}
		.zona .s-video > video {
			aspect-ratio: var(--formato-movil, var(--formato));
		}
		.zona > * {
			left: var(--mx, var(--x));
			top: var(--my, var(--y));
			width: var(--mw, var(--w));
			transform: rotate(var(--mrot, var(--rot)));
		}
	}
	.s-adorno {
		height: auto;
		overflow: visible;
		filter: drop-shadow(0 0.6cqi 0.8cqi rgb(43 39 64 / 0.18));
	}

	/* Photos */
	.s-foto {
		background: #fff;
		box-shadow:
			0 0.3cqi 0.6cqi rgb(43 39 64 / 0.16),
			0 1.8cqi 3cqi -1cqi rgb(43 39 64 / 0.3);
	}
	.s-foto--borde {
		padding: 1.6cqi;
	}
	.s-foto--polaroid {
		padding: 3cqi 3cqi 0;
	}
	/* Rotated pictures: a clip-path with a tiny rounded inset makes the browser draw the
	   picture's edge antialiased, so the line against the white frame is not jagged. */
	.s-foto :global(img),
	.s-video video,
	.s-pelicula :global(img) {
		clip-path: inset(0.5px round 1px);
	}
	.s-foto :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: var(--formato);
		object-fit: cover;
	}
	.s-foto figcaption {
		padding: 1.8cqi 0 2.6cqi;
		font-size: calc(5cqi * var(--mano) * var(--escala));
		font-weight: 400;
		text-align: center;
	}
	.s-foto--polaroid:not(:has(figcaption)) {
		padding-bottom: 7cqi;
	}
	.s-foto__fecha {
		position: absolute;
		/* Grows to the right, into the page, never past the canvas's left edge. */
		left: 1.6cqi;
		bottom: -5.2cqi;
		font-family: var(--font-notas), 'Courier New', monospace;
		font-size: calc(3.2cqi * var(--escala));
		letter-spacing: 0.06em;
		white-space: nowrap;
		color: var(--ink-papel);
	}
	/* Washi tape */
	.s-foto--arriba::before,
	.s-foto--esquinas::before,
	.s-foto--esquinas::after {
		content: '';
		position: absolute;
		z-index: 1;
		width: 30%;
		height: 6.5cqi;
		background-color: color-mix(in srgb, var(--tinta) 65%, transparent);
		background-image: repeating-linear-gradient(
			90deg,
			rgb(255 255 255 / 0.3) 0 1.2cqi,
			transparent 1.2cqi 2.4cqi
		);
		box-shadow: 0 0.2cqi 0.4cqi rgb(43 39 64 / 0.12);
	}
	.s-foto--arriba::before {
		top: -3.2cqi;
		left: 35%;
		transform: rotate(-3deg);
	}
	.s-foto--esquinas::before {
		top: -1.6cqi;
		left: -7%;
		transform: rotate(-38deg);
	}
	.s-foto--esquinas::after {
		bottom: -1.6cqi;
		right: -7%;
		transform: rotate(-38deg);
	}
	/* Paperclip over the top edge */
	.s-clip {
		position: absolute;
		z-index: 1;
		top: -6cqi;
		left: 10%;
		width: 5.5cqi;
		height: auto;
		fill: none;
		stroke: #9aa1b2;
		stroke-width: 2.4;
		stroke-linecap: round;
		filter: drop-shadow(0 0.3cqi 0.3cqi rgb(43 39 64 / 0.3));
	}

	/* Video */
	.s-video {
		padding: 1.8cqi;
		background: #fff;
		box-shadow: 0 1.8cqi 3cqi -1cqi rgb(43 39 64 / 0.35);
	}
	/* Top-right, shown only while the pointer is over the video or a control has
	   keyboard focus. Touch screens have no hover: there a tap on the video shows
	   them for a few seconds (script below). Hidden controls take no taps. */
	.s-video__controles {
		position: absolute;
		top: 3.5cqi;
		right: 3.5cqi;
		display: flex;
		gap: 0.4rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}
	.s-video:focus-within .s-video__controles,
	.s-video.is-controles .s-video__controles {
		opacity: 1;
		pointer-events: auto;
	}
	@media (hover: hover) {
		.s-video:hover .s-video__controles {
			opacity: 1;
			pointer-events: auto;
		}
	}
	.s-video__boton {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--violet-600);
		color: #fff;
		cursor: pointer;
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.2);
		transition: transform 0.15s ease;
	}
	.s-video__boton:hover {
		transform: scale(1.06);
	}
	.s-video__boton[hidden] {
		display: none;
	}
	.s-video__boton svg {
		width: 20px;
		height: 20px;
