---
import { perfil } from '../data/cv';
import logo from '../assets/logo-cata-callejas.svg';
import type { Section } from '../lib/nav';

interface Props {
	current?: Section;
}
const { current } = Astro.props;

const links: { id: Section; href: string; texto: string }[] = [
	{ id: 'hablando', href: '/hablando-nuestro-trabajo', texto: 'Hablando' },
	{ id: 'artefactos', href: '/artefactos', texto: 'Artefactos' },
];
---

<header class="header">
	<div class="container header__inner">
		<a class="logo" href="/">
			<img
				src={logo.src}
				width={logo.width}
				height={logo.height}
				alt={`${perfil.nombreCorto}, ir al inicio`}
			/>
		</a>
		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="menu-principal"
			hidden
		>
			<span class="visually-hidden">Menú</span>
			<span class="menu-toggle__bars" aria-hidden="true"></span>
		</button>
		<nav id="menu-principal" class="nav" aria-label="Principal">
			<ul class="nav__list">
				{
					links.map((l) => (
						<li>
							<a
								class="nav__link"
								href={l.href}
								aria-current={current === l.id ? 'page' : undefined}
							>
								{l.texto}
							</a>
						</li>
					))
				}
				<li>
					<a
						class="nav__cta"
						href="/sobre-mi"
						aria-current={current === 'sobre-mi' ? 'page' : undefined}>Sobre mí</a
					>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	// Mobile menu. Without JS the toggle stays hidden and the links simply wrap.
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const nav = document.getElementById('menu-principal');
	if (toggle && nav) {
		document.documentElement.classList.add('has-menu-js');
		toggle.hidden = false;
		const set = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			nav.classList.toggle('is-open', open);
		};
		toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && nav.classList.contains('is-open')) {
				set(false);
				toggle.focus();
			}
		});
		nav.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('a')) set(false);
		});
	}
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgb(250 250 252 / 0.9);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	.header__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 1rem;
		min-height: 4rem;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 44px;
		text-decoration: none;
		font-size: 1.15rem;
		line-height: 1;
	}
	.logo img {
		height: 44px;
		width: auto;
	}
	.nav__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 clamp(0.25rem, 2vw, 1rem);
		list-style: none;
		padding: 0;
		font-size: 0.95rem;
	}
	.nav__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: 0.5rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 2px solid transparent;
	}
	.nav__link:hover {
		color: var(--violet-ink);
	}
	.nav__link[aria-current='page'] {
		color: var(--violet-ink);
		font-weight: 600;
		border-bottom-color: var(--violet);
	}
	.nav__cta {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 1.1rem;
		border-radius: 999px;
		background: var(--violet);
		color: #fff;
		text-decoration: none;
		font-weight: 500;
		transition: background-color 0.15s ease;
	}
	.nav__cta:hover {
		background: var(--violet-ink);
	}
	.nav__cta[aria-current='page'] {
		background: var(--violet-800);
	}

	.menu-toggle {
		display: none;
		width: 44px;
		height: 44px;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		cursor: pointer;
	}
	.menu-toggle__bars,
	.menu-toggle__bars::before,
	.menu-toggle__bars::after {
		display: block;
		width: 22px;
		height: 2px;
		margin-inline: auto;
		background: var(--ink);
		border-radius: 2px;
		position: relative;
	}
	.menu-toggle__bars::before,
	.menu-toggle__bars::after {
		content: '';
		position: absolute;
	}
	.menu-toggle__bars::before {
		top: -7px;
	}
	.menu-toggle__bars::after {
		top: 7px;
	}

	@media (max-width: 47.99rem) {
		:global(.has-menu-js) .menu-toggle {
			display: block;
		}
		:global(.has-menu-js) .nav {
			display: none;
			flex-basis: 100%;
			padding-bottom: 1rem;
		}
		:global(.has-menu-js) .nav.is-open {
			display: block;
		}
		:global(.has-menu-js) .nav__list {
			flex-direction: column;
			align-items: stretch;
		}
		:global(.has-menu-js) .nav__cta {
			justify-content: center;
			margin-top: 0.5rem;
		}
	}
</style>
