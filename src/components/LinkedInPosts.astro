---
/**
 * The latest LinkedIn posts, using LinkedIn's official embed (one iframe per post,
 * lazy-loaded). LinkedIn offers no public feed for a personal profile, so the list
 * comes from src/data/cv.ts (`postsLinkedIn`). Without posts, a pending placeholder.
 */
import Pending from './Pending.astro';

interface Props {
	posts: { url: string }[];
	/** Same height for every card (LinkedIn's embed can't be auto-sized from here). */
	height?: number;
	limit?: number;
}
const { posts, limit = 3, height = 640 } = Astro.props;

/** Accepts a post URL or an embed URL and returns the embed URL, if it can. */
const toEmbed = (url: string) => {
	if (url.includes('/embed/feed/update/')) return url;
	const id = url.match(/(?:activity|share|ugcPost)[-:](\d{15,})/)?.[1];
	if (!id) return undefined;
	const kind = url.includes('ugcPost') ? 'ugcPost' : url.includes('share') ? 'share' : 'activity';
	return `https://www.linkedin.com/embed/feed/update/urn:li:${kind}:${id}`;
};
const items = posts
	.slice(0, limit)
	.map(({ url }) => ({ url, embed: toEmbed(url) }))
	.filter((p) => p.embed);
---

{
	items.length > 0 ? (
		<ul class="li__grid">
			{items.map((p, i) => (
				<li>
					<iframe
						src={p.embed}
						title={`Publicación ${i + 1} de Catalina Callejas en LinkedIn`}
						loading="lazy"
						height={height}
						width="100%"
						allowfullscreen
					/>
				</li>
			))}
		</ul>
	) : (
		/* TODO(content): los 3 últimos posts de LinkedIn en src/data/cv.ts (postsLinkedIn). */
		<Pending label="tus 3 últimos posts de LinkedIn (src/data/cv.ts)" />
	)
}

<style>
	.li__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: 1rem;
		align-items: start;
		list-style: none;
		padding: 0;
	}
	.li__grid iframe {
		display: block;
		width: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
	}
</style>
