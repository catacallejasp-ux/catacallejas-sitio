---
/**
 * Browser window playing a step-by-step sequence of screenshots (cross-fade).
 * Screenshots live in src/assets/mockups/demo/ as desktop-N-*.png, one per step,
 * sorted by N.
 *
 * Motion and accessibility:
 * - Autoplays only with JS and without prefers-reduced-motion; pauses off-screen.
 * - Small pause/play icon button on the window (WCAG 2.2.2); also pauses on hover.
 * - Without JS: shows the first step, static.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** One label per step, in order (read by screen readers, not shown). */
	steps: string[];
	/** Accessible description of the whole sequence. */
	label: string;
	/** Text shown in the fake address bar. */
	address?: string;
	/** Milliseconds per step. */
	interval?: number;
}
const { steps, label, address, interval = 3200 } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/mockups/demo/*.png', {
	eager: true,
});
const desktop = Object.entries(files)
	.filter(([path]) => path.includes('/desktop-'))
	.sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
	.map(([, mod]) => mod.default);
if (desktop.length !== steps.length) {
	throw new Error(`DeviceMockup: ${steps.length} steps but ${desktop.length} frames`);
}
---

<figure class="mockup" data-mockup data-interval={interval}>
	<div class="mockup__devices">
		<div class="browser">
			<div class="browser__bar" aria-hidden="true">
				<span class="browser__dots"><i></i><i></i><i></i></span>
				{address && <span class="browser__address">{address}</span>}
			</div>
			<div class="frames frames--desktop">
				{
					desktop.map((src, i) => (
						<Image
							class:list={['frame', i === 0 && 'is-active']}
							src={src}
							alt=""
							widths={[480, 720, 1080]}
							sizes="(max-width: 900px) 90vw, 560px"
							loading={i === 0 ? 'eager' : 'lazy'}
						/>
					))
				}
			</div>
		</div>
	</div>

	<figcaption class="visually-hidden">{label} Pasos: {steps.join(', ')}.</figcaption>
	<!-- Autoplay needs a way to stop it (WCAG 2.2.2): small icon button, bottom-right. -->
	<button class="mockup__pause" type="button" aria-pressed="false" data-pause hidden>
		<span class="visually-hidden" data-pause-label>Pausar demostración</span>
		<svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
			<path
				class="icon-pause"
				d="M7 5v10M13 5v10"
				stroke="currentColor"
				stroke-width="2.2"
				stroke-linecap="round"></path>
			<path class="icon-play" d="M7 5l8 5-8 5z" fill="currentColor"></path>
		</svg>
	</button>
</figure>

<script>
	document.querySelectorAll<HTMLElement>('[data-mockup]').forEach((root) => {
		const interval = Number(root.dataset.interval) || 3200;
		const sets = [[...root.querySelectorAll<HTMLElement>('.frames--desktop .frame')]];
		const total = sets[0].length;
		const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
		const pauseLabel = root.querySelector('[data-pause-label]')!;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let current = 0;
		let playing = !reduce;
		let visible = false;
		let hovering = false;
		let timer: number | undefined;

		const show = (i: number) => {
			current = (i + total) % total;
			sets.forEach((set) => set.forEach((f, n) => f.classList.toggle('is-active', n === current)));
		};
		const tick = () => {
			window.clearTimeout(timer);
			if (playing && visible && !hovering)
				timer = window.setTimeout(() => (show(current + 1), tick()), interval);
		};
		const setPlaying = (on: boolean) => {
			playing = on;
			pause.setAttribute('aria-pressed', String(!on));
			pauseLabel.textContent = on ? 'Pausar demostración' : 'Reproducir demostración';
			root.classList.toggle('is-paused', !on);
			tick();
		};

		pause.hidden = false;
		pause.addEventListener('click', () => setPlaying(!playing));
		root.addEventListener('mouseenter', () => ((hovering = true), tick()));
		root.addEventListener('mouseleave', () => ((hovering = false), tick()));
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			tick();
		}).observe(root);

		setPlaying(playing);
	});
</script>

<style>
	.mockup {
		margin: 0;
	}
	.mockup__devices {
		position: relative;
	}
	.browser {
		overflow: hidden;
		border-radius: 14px;
		background: var(--surface);
		border: 1px solid var(--line);
		box-shadow: 0 24px 50px -24px rgb(65 51 166 / 0.35);
	}
	.browser__bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 0.8rem;
		background: var(--neutral-100);
		border-bottom: 1px solid var(--line);
	}
	.browser__dots {
		display: flex;
		gap: 0.35rem;
		flex: none;
	}
	.browser__dots i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--neutral-300);
	}
	.browser__dots i:first-child {
		background: var(--violet-300);
	}
	.browser__dots i:nth-child(2) {
		background: var(--teal-300);
	}
	.browser__address {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		padding: 0.2rem 0.75rem;
		border-radius: 999px;
		background: var(--surface);
		font-size: 0.72rem;
		color: var(--ink-muted);
	}

	/* Stacked frames; only the active one is visible. */
	.frames {
		display: grid;
	}
	.frames :global(.frame) {
		grid-area: 1 / 1;
		display: block;
		width: 100%;
		height: auto;
		opacity: 0;
		transition: opacity 0.6s ease;
	}
	.frames :global(.frame.is-active) {
		opacity: 1;
	}

	/* Pause button, overlaid on the bottom-right of the browser window. */
	.mockup {
		position: relative;
	}
	.mockup__pause {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1px solid var(--edge);
		border-radius: 50%;
		background: color-mix(in srgb, var(--paper) 75%, transparent);
		color: var(--violet-700);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		box-shadow: 0 4px 14px rgb(65 51 166 / 0.18);
		cursor: pointer;
		opacity: 0.85;
		transition: opacity 0.2s ease;
	}
	.mockup__pause:hover,
	.mockup__pause:focus-visible {
		opacity: 1;
	}
	.icon-play,
	.is-paused .icon-pause {
		display: none;
	}
	.is-paused .icon-play {
		display: inline;
	}
	@media (prefers-reduced-motion: reduce) {
		.frames :global(.frame) {
			transition: none;
		}
	}
</style>
