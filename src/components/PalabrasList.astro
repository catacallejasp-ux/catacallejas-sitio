---
/**
 * Articles as a list — title, tags, date and a «Leer artículo» link. Columns on wide
 * screens, stacked on phones.
 * - `table` (home, «Algunas palabras e ideas»): rows divided by lines.
 * - `bars` (/palabras): each row a rounded bar on a soft gradient, tones cycling.
 */
import Icon from './Icon.astro';
import { getPalabras, urlPalabra, fechaCorta, isoDate } from '../lib/palabras';

interface Props {
	/** Maximum number of articles shown. */
	max?: number;
	variant?: 'table' | 'bars';
	/** Heading level of each title (h3 under a section h2; h2 directly under the page h1). */
	headingLevel?: 2 | 3;
}
const { max = Infinity, variant = 'table', headingLevel = 3 } = Astro.props;
const items = (await getPalabras()).slice(0, max);
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<div class:list={['words', variant === 'bars' && 'words--bars']}>
	<ul class="words__list">
		{
			items.map((p) => (
				<li class="words__row">
					<Heading class="words__title">
						<a href={urlPalabra(p.id)}>{p.data.title}</a>
					</Heading>
					<ul class="chips words__tags" aria-label="Temas">
						{p.data.tags.map((t) => (
							<li class="chip chip--strong">{t}</li>
						))}
					</ul>
					<time class="words__date" datetime={isoDate(p.data.date)}>
						{fechaCorta(p.data.date)}
					</time>
					<a
						class="button button--ghost button--sm words__cta"
						href={urlPalabra(p.id)}
						tabindex="-1"
					>
						Leer artículo
						<Icon name="arrow-right" />
						<span class="visually-hidden">: {p.data.title}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>

<style>
	.words__list {
		list-style: none;
		padding: 0;
	}
	.words__row {
		position: relative;
		display: grid;
		gap: 0.75rem;
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--neutral-400);
	}
	.words__list > .words__row:first-child {
		border-top: 1px solid var(--neutral-400);
	}
	.words__title {
		font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.3;
		max-width: 34ch;
	}
	.words__title a {
		color: inherit;
		text-decoration: none;
	}
	/* The whole row is the link target; the title link carries the name. */
	.words__title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.words__row:hover .words__title a,
	.words__title a:focus-visible {
		color: var(--violet-ink);
	}
	.words__title a:focus-visible {
		outline: none;
	}
	.words__row:has(.words__title a:focus-visible) {
		outline: 3px solid var(--violet-500);
		outline-offset: 4px;
		border-radius: var(--radius-sm);
	}
	.words__date {
		color: var(--ink-muted);
		font-variant-numeric: tabular-nums;
	}
	.words__cta {
		justify-self: start;
		position: relative;
		z-index: 1;
	}
	.words__row:hover .words__cta {
		background: var(--violet-100);
	}

	@media (min-width: 56rem) {
		.words__row {
			grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.6fr) 7.5rem auto;
			align-items: center;
			column-gap: 1.5rem;
		}
		.words__cta {
			justify-self: end;
		}
	}

	/* ---- Bars (/palabras) ---- */
	.words--bars .words__list {
		display: grid;
		gap: 0.75rem;
	}
	.words--bars .words__row,
	.words--bars .words__list > .words__row:first-child {
		padding: 1.25rem clamp(1.25rem, 3vw, 1.75rem);
		border: 0;
		border-radius: var(--radius);
		box-shadow: inset 0 0 0 1px var(--edge);
		transition: transform 0.2s ease;
	}
	/* Four tones from the site palette, repeating; each has its dark counterpart.
	   Every tone is a 200 step so each bar reads against the violet-50 section and
	   text keeps AA in both themes; bars 3 and 4 flip the direction of 1 and 2. */
	.words--bars .words__row:nth-child(4n + 1) {
		background: linear-gradient(100deg, var(--violet-200), var(--teal-100));
	}
	.words--bars .words__row:nth-child(4n + 2) {
		background: linear-gradient(100deg, var(--teal-200), var(--violet-100));
	}
	.words--bars .words__row:nth-child(4n + 3) {
		background: linear-gradient(280deg, var(--violet-200), var(--teal-100));
	}
	.words--bars .words__row:nth-child(4n + 4) {
		background: linear-gradient(280deg, var(--teal-200), var(--violet-100));
	}
	.words--bars .words__row:hover {
		transform: translateY(-2px);
	}
	.words--bars .words__row:has(.words__title a:focus-visible) {
		border-radius: var(--radius);
	}
	.words--bars .words__date {
		color: var(--neutral-700);
	}
	/* On the tinted bar the button gets the raised (white) fill, like the reference. */
	.words--bars .words__cta,
	.words--bars .words__row:hover .words__cta {
		background: var(--raised);
	}
	@media (prefers-reduced-motion: reduce) {
		.words--bars .words__row {
			transition: none;
		}
		.words--bars .words__row:hover {
			transform: none;
		}
	}
</style>
