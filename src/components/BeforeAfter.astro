---
/**
 * Before / after comparison: the «after» image sits over the «before» one and is
 * revealed up to a divider. Drag anywhere on the image, or use the slider (a real
 * <input type="range">, so keyboard and screen readers work: ←/→, Home/End).
 * Without JS both images show one under the other.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	titulo: string;
	antes: ImageMetadata;
	antesAlt: string;
	despues: ImageMetadata;
	despuesAlt: string;
	mejoras?: string[];
}
const { titulo, antes, antesAlt, despues, despuesAlt, mejoras = [] } = Astro.props;
const id = 'comparador';
---

<section class="ba" aria-labelledby={`${id}-titulo`}>
	<h2 id={`${id}-titulo`}>{titulo}</h2>
	<p class="ba__hint" data-ba-hint hidden>Desliza la línea para comparar el antes y el después.</p>

	<div class="ba__frame" data-ba style="--pos: 50%">
		<figure class="ba__layer ba__layer--antes">
			<Image
				src={antes}
				alt={antesAlt}
				widths={[800, 1400, 2000]}
				sizes="(max-width: 72rem) 100vw, 72rem"
			/>
			<figcaption class="ba__tag ba__tag--antes">Antes</figcaption>
		</figure>
		<figure class="ba__layer ba__layer--despues">
			<Image
				src={despues}
				alt={despuesAlt}
				widths={[800, 1400, 2000]}
				sizes="(max-width: 72rem) 100vw, 72rem"
			/>
			<figcaption class="ba__tag ba__tag--despues">Después</figcaption>
		</figure>
		<div class="ba__divider" aria-hidden="true">
			<span class="ba__handle">
				<svg
					viewBox="0 0 24 24"
					width="22"
					height="22"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6"></path></svg
				>
			</span>
		</div>
		<input
			class="ba__range"
			type="range"
			min="0"
			max="100"
			value="50"
			step="1"
			aria-label="Comparar antes y después: a la izquierda, más del antes; a la derecha, más del después"
			aria-valuetext="50 % del después visible"
			hidden
		/>
	</div>

	{
		mejoras.length > 0 && (
			<div class="ba__notes">
				<h3>Principales mejoras</h3>
				<ul>
					{mejoras.map((m) => (
						<li>{m}</li>
					))}
				</ul>
			</div>
		)
	}
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-ba]').forEach((frame) => {
		const range = frame.querySelector<HTMLInputElement>('.ba__range')!;
		const hint = frame.parentElement?.querySelector<HTMLElement>('[data-ba-hint]');
		frame.classList.add('is-enhanced');
		range.hidden = false;
		if (hint) hint.hidden = false;

		// The «after» layer covers the right side of the divider: dragging right shows more «before».
		const set = (v: number) => {
			const pos = Math.max(0, Math.min(100, v));
			frame.style.setProperty('--pos', `${pos}%`);
			range.value = String(Math.round(pos));
			range.setAttribute('aria-valuetext', `${100 - Math.round(pos)} % del después visible`);
		};
		range.addEventListener('input', () => set(Number(range.value)));

		const fromPointer = (e: PointerEvent) => {
			const r = frame.getBoundingClientRect();
			set(((e.clientX - r.left) / r.width) * 100);
		};
		let dragging = false;
		frame.addEventListener('pointerdown', (e) => {
			dragging = true;
			frame.setPointerCapture(e.pointerId);
			fromPointer(e);
		});
		frame.addEventListener('pointermove', (e) => dragging && fromPointer(e));
		const stop = () => (dragging = false);
		frame.addEventListener('pointerup', stop);
		frame.addEventListener('pointercancel', stop);
	});
</script>

<style>
	.ba h2 {
		font-size: 1.6rem;
	}
	.ba__hint {
		margin-top: 0.5rem;
		color: var(--ink-muted);
	}
	.ba__frame {
		position: relative;
		margin-top: 1.5rem;
	}
	.ba__layer {
		margin: 0;
	}
	.ba__layer :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		border: 1px solid var(--line);
	}
	/* Without JS: one under the other, each with its label. */
	.ba__frame:not(.is-enhanced) .ba__layer + .ba__layer {
		margin-top: 1.5rem;
	}
	.ba__tag {
		position: absolute;
		top: 1rem;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
		background: rgb(255 255 255 / 0.9);
		color: var(--violet-800);
		box-shadow: 0 4px 12px -6px rgb(28 32 48 / 0.35);
		pointer-events: none;
	}
	.ba__layer {
		position: relative;
	}
	.ba__tag--antes {
		left: 1rem;
	}
	.ba__tag--despues {
		right: 1rem;
		background: var(--violet-700);
		color: #fff;
	}
	.ba__divider,
	.ba__range {
		display: none;
	}

	/* Enhanced: stacked, «after» clipped to the right of the divider. */
	.is-enhanced {
		overflow: hidden;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
		cursor: ew-resize;
		touch-action: pan-y;
		user-select: none;
	}
	.is-enhanced .ba__layer :global(img) {
		border: 0;
		border-radius: 0;
		pointer-events: none;
		-webkit-user-drag: none;
	}
	.is-enhanced .ba__layer--despues {
		position: absolute;
		inset: 0;
		clip-path: inset(0 0 0 var(--pos));
	}
	.is-enhanced .ba__layer--despues :global(img) {
		height: 100%;
		object-fit: cover;
	}
	.is-enhanced .ba__divider {
		display: block;
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--pos);
		width: 3px;
		transform: translateX(-50%);
		background: #fff;
		box-shadow: 0 0 0 1px rgb(65 51 166 / 0.25);
		pointer-events: none;
	}
	.ba__handle {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		transform: translate(-50%, -50%);
		border-radius: 999px;
		background: var(--violet-700);
		color: #fff;
		box-shadow: 0 6px 18px -6px rgb(28 32 48 / 0.5);
		border: 3px solid #fff;
	}
	/* The range covers the frame invisibly: it takes keyboard focus and shows the ring. */
	.is-enhanced .ba__range {
		display: block;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: ew-resize;
		pointer-events: none;
	}
	.is-enhanced:has(.ba__range:focus-visible) {
		outline: 3px solid var(--violet);
		outline-offset: 4px;
	}

	.ba__notes {
		margin-top: 1.75rem;
	}
	.ba__notes h3 {
		font-size: 1.2rem;
	}
	.ba__notes ul {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.75rem;
		padding-left: 1.25rem;
	}
	.ba__notes li::marker {
		color: var(--violet-700);
	}
</style>
